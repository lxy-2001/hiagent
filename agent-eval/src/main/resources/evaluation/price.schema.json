{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inputPerMillion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    },
    "outputPerMillion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,8})?$"
    }
  },
  "required": [
    "id",
    "provider",
    "model",
    "date",
    "currency",
    "source",
    "inputPerMillion",
    "outputPerMillion"
  ]
}
