{
  "name": "@hiagent/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test visual.spec.ts responsive.spec.ts auth.spec.ts approval.spec.ts states.spec.ts performance.spec.ts --project=chromium",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "markdown-it": "15.0.2",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "@lucide/vue": "1.48.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "8.3.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "eslint-plugin-vue": "10.11.1",
    "vue-eslint-parser": "10.4.1",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.0"
  }
}
