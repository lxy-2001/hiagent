# Copy to a local .env file and replace placeholders with local values.
# Do not commit the local .env file.

MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
MYSQL_DATABASE=agentflow
MYSQL_USER=agentflow

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/agentflow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=agentflow
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

AGENTFLOW_MODEL_PROVIDER=deepseek
AGENTFLOW_MODEL_BASE_URL=https://example.invalid/compatible-api
AGENTFLOW_MODEL_API_KEY=CHANGE_ME_MODEL_API_KEY
AGENTFLOW_MODEL_CHAT_MODEL=deepseek-v4-pro
AGENTFLOW_MODEL_EMBEDDING_MODEL=text-embedding-v4
AGENTFLOW_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_AT_LEAST_32_BYTES
AGENTFLOW_INITIAL_ADMIN_USERNAME=CHANGE_ME_LOCAL_ADMIN_USERNAME
AGENTFLOW_INITIAL_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
QDRANT_BASE_URL=http://localhost:6333
